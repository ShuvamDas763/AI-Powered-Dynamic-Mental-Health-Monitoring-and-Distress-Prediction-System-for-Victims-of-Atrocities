# ---------------------------------------------------------------------------
# SIH26094 — environment template
#
# SETUP: copy this file to `.env` and fill in the real values.
#     cp .env.example .env
#
# `.env` is git-ignored. Never put a real key in this file — this template is
# committed, so anything written here becomes public to everyone with the repo.
# ---------------------------------------------------------------------------

# --- LLM provider (required) -----------------------------------------------
# Groq is the chosen inference provider for distress scoring, explainability
# text, and intervention recommendations. Get a key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Model used for the scoring / explainability pipeline.
# Chosen after a dedicated content-safety + calibration probe of the models this
# account can actually serve (see docs/model-selection.md). gpt-oss-120b was the
# best-calibrated option and had the safest failure mode under adversarial input.
GROQ_MODEL=openai/gpt-oss-120b

# Secondary model. Used only if the primary errors or times out, before falling
# back to a cached response. Faster but scores lower on the same input, so it is
# never the primary — under-scoring distress is the dangerous direction here.
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

# Moderation pass over generated text before it is shown to anyone. Guards the
# content-safety rules (no diagnostic labels, no graphic detail) at runtime
# rather than trusting the generating model to always comply.
GROQ_MODEL_MODERATION=openai/gpt-oss-safeguard-20b

# --- Demo reliability ------------------------------------------------------
# Milliseconds to wait on a live LLM call before giving up and serving the
# pre-generated cached response instead. Keeps a jury demo from stalling on a
# slow network. Lower = snappier fallback, higher = more live results.
LLM_TIMEOUT_MS=8000

# Set to `true` to bypass live API calls entirely and serve only cached
# responses. Useful as a panic switch if the venue network is unusable.
FORCE_FALLBACK_MODE=false

# --- Server ----------------------------------------------------------------
# Port for the API server. Named API_PORT, not PORT, on purpose: dev tooling
# often injects PORT for the frontend, and if the API read that too it would
# start on the client's port and the Vite proxy would fail.
API_PORT=3001

# Session secret for the server-side role session that enforces the two-tier
# access boundary. Any long random string is fine for a local prototype.
SESSION_SECRET=change_me_to_a_long_random_string

# --- Optional: multilingual ------------------------------------------------
# Left blank by default — multilingual check-ins are handled by prompting the
# LLM in the target language. Only fill these in if you wire up Bhashini.
BHASHINI_USER_ID=
BHASHINI_API_KEY=
