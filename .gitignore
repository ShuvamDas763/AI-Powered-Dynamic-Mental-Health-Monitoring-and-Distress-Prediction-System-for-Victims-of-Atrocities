# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
# The real API key lives in .env (git-ignored). .env.example is the committed
# template showing which keys a teammate needs to fill in.
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Local data store (seeded at runtime — regenerate, don't commit)
*.sqlite
*.sqlite3
*.db
data/local/

# Test / tooling artefacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# Python (if any tooling scripts are added)
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Agent tooling installed locally (third-party plugin checkouts, each with its
# own .git). Machine-local developer tooling, not part of this project.
.agents/

# Freebuff runtime logs
.freebuff/

# Temp test responses
crisis_resp*.json
cookies.txt

# ---------------------------------------------------------------------------
# Internal team documents — kept LOCAL ONLY, not published to the repo.
# These are private pitch/interview-prep materials (speaker notes, judge
# Q&A drilling, briefing docs, slide PDFs, captured screenshots). If you
# re-enable one deliberately, move it out of docs/private first.
# ---------------------------------------------------------------------------
docs/pitch-briefing.md
docs/pitch-briefing.pdf
docs/speaker-notes.md
docs/speaker-notes.pdf
docs/HexaForge-SIH26094.pdf
docs/screenshots/
docs/~$*

# Stray lockfile created by running npm inside the client workspace
client/package-lock.json
